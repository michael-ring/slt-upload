DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=replace-with-your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
# One or more Discord server IDs, separated by commas.
DISCORD_GUILD_IDS=

SESSION_SECRET=replace-with-a-long-random-session-secret
COOKIE_SECURE=false

# source bucket to fetch project names from
SOURCE_S3_BUCKET=source-project-bucket
SOURCE_S3_ENDPOINT_URL=https://s3.example.com
SOURCE_S3_REGION=us-east-1
SOURCE_S3_ACCESS_KEY_ID=source-access-key
SOURCE_S3_SECRET_ACCESS_KEY=source-secret-key

# destination bucket where images will be uploaded to
UPLOAD_S3_BUCKET=member-image-bucket
UPLOAD_S3_ENDPOINT_URL=https://s3.example.com
UPLOAD_S3_REGION=us-east-1
UPLOAD_S3_ACCESS_KEY_ID=upload-access-key
UPLOAD_S3_SECRET_ACCESS_KEY=upload-secret-key

PROJECT_CACHE_TTL_SECONDS=900
MAX_UPLOAD_SIZE_BYTES=26214400
HOST=0.0.0.0
PORT=8000
